return [a1*a2 + a1*b2 + b1*b2 + a2*d1 + a1*b2*d1 + a2*b2*d1, a1*a2 + a1*b2 + b1*b2 + a2*d1 + a1*b2*d1 + a2*b2*d1, a1*a2 + a1*b2 + b1*b2 + a2*d1 + a1*b2*d1 + a2*b2*d1, a2 + a2*b1 + a1*b2 + a2*d1 + b2*d1 + a2*b2*d1 + b1*b2*d1, 1 + a2 + a2*b1 + a1*b2 + d1 + a2*d1 + b2*d1 + a2*b2*d1 + b1*b2*d1, a2 + a2*b1 + a1*b2 + d1 + a2*d1 + b2*d1 + a2*b2*d1 + b1*b2*d1, a1*a2 + a2*b1 + b2 + b1*b2 + a2*d1 + a1*b2*d1 + a2*b2*d1 + b1*b2*d1, a1*a2 + a2*b1 + b2 + b1*b2 + d1 + a2*d1 + a1*b2*d1 + a2*b2*d1 + b1*b2*d1, 1 + a1*a2 + a2*b1 + b2 + b1*b2 + d1 + a2*d1 + a1*b2*d1 + a2*b2*d1 + b1*b2*d1][1 + 3*c1 + c2];
end;
