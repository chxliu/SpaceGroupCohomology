local x1,y1,z1,x2,y2,z2,a1,a2,b1,b2,c1,c2;
x1:=g1[1];y1:=g1[2];z1:=g1[3];x2:=g2[1];y2:=g2[2];z2:=g2[3];a1:=g1[4];a2:=g2[4];b1:=g1[5];b2:=g2[5];c1:=g1[6];c2:=g2[6];
