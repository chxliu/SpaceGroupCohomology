#####################################################################
CgammaRin225:=function(g1,g2,g3)
return CgammaTexin225(g1,g2,g3)
    + Aiin225(g1)*Aiin225(g2)*Aiin225(g3)
    + Aiin225(g1)*Aiin225(g2)*Amin225(g3)
    + Aiin225(g1)*Balphain225(g2,g3)
    + Aiin225(g1)*Bxyxzyzin225(g2,g3)
    + Amin225(g1)*Bxyxzyzin225(g2,g3)
    + Calphain225(g1,g2,g3);
end;
#####################################################################
CxyzRin225:=function(g1,g2,g3)
return CxyzTexin225(g1,g2,g3)
    + CgammaTexin225(g1,g2,g3)
    + Amin225(g1)*Bxyxzyzin225(g2,g3);
end;
