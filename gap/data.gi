Axyzin108:=function(g1)
local x1,y1,z1,a1,b1,c1;
x1:=g1[1];y1:=g1[2];z1:=g1[3];a1:=g1[4];b1:=g1[5];c1:=g1[6];
return x1 + y1 + z1;
end;
