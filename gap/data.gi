Aiin138:=function(g1)
local x1,y1,z1,a1,b1,c1,d1;
x1:=g1[1];y1:=g1[2];z1:=g1[3];a1:=g1[4];b1:=g1[5];c1:=g1[6];d1:=g1[7];
return d1;
end;
